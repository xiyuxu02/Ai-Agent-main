# 复制为 backend/.env，并替换所有占位值。不要提交 .env。

# OpenAI 兼容接口（默认示例为 DeepSeek）
OPENAI_API_KEY=replace-with-your-api-key
OPENAI_MODEL=deepseek-chat
OPENAI_BASE_URL=https://api.deepseek.com
TEMPERATURE=0.3
MAX_TOKENS=2000

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=ai_agent
MYSQL_PASSWORD=ai-agent-local
MYSQL_DATABASE=ai_agent

# 会话访问令牌签名密钥。部署时必须替换为随机长字符串，并在所有实例间保持一致。
CONVERSATION_SIGNING_SECRET=replace-with-a-long-random-secret

# 登录会话。HTTPS 部署必须设为 true；本地 HTTP 开发保持 false。
AUTH_COOKIE_SECURE=false
AUTH_SESSION_DAYS=7
AUTH_PASSWORD_ITERATIONS=600000

# 安全与资源边界
PENDING_ACTION_TTL_MINUTES=10
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
MAX_CONCURRENT_CHAT_REQUESTS=8
AGENT_TIMEOUT_SECONDS=55

# 缓存与记忆
AGENT_CACHE_MAX_SIZE=100
AGENT_CACHE_TTL_SECONDS=1800
MEMORY_CACHE_MAX_CONVERSATIONS=100
MEMORY_MAX_MESSAGES=100

# 浏览器来源白名单；启用凭据时不要使用 *
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# 开发排查时才设为 true，避免日志泄露提示词或业务数据。
AGENT_VERBOSE=false
